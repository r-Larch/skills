# Build output. plugins/rlarch/skills/dotnet-source/tool is a real .NET project, so building or debugging it locally
# produces bin/obj here. The shipped artifact is the SOURCE — ds.ps1/ds.sh compile it on first use
# into a hash-keyed cache under the temp dir, so nothing built ever belongs in the repo.
bin/
obj/

# Local Claude Code state: per-run artifacts and briefs, not team artifacts.
.claude/orchestration/
.claude/briefs/
.claude/settings.local.json

# Rider / VS / VS Code
.vs/
.idea/
*.user
*.suo
*.DotSettings.user

# Node (ts-source's dev-only typecheck)
node_modules/
