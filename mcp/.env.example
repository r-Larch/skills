# Copy to mcp/.env and fill in. Read by `docker compose -f mcp/compose.yml`.
# Blank on purpose: compose refuses to start rather than boot with a guessable secret.

# Bearer tokens presented on /mcp, one per role profile (doc 01 §6). They nest: a controller
# token also satisfies orchestrator and worker, so mint the narrowest one an agent needs.
WORKSTATE_WORKER_TOKEN=
WORKSTATE_ORCHESTRATOR_TOKEN=
WORKSTATE_CONTROLLER_TOKEN=

# Host port the API is published on.
WORKSTATE_API_PORT=5290

POSTGRES_DB=workstate
POSTGRES_USER=workstate
POSTGRES_PASSWORD=
