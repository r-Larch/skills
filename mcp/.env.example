# Copy to mcp/.env and fill in. Read by `docker compose -f mcp/compose.yml`.
# Blank on purpose: compose refuses to start rather than boot with a guessable secret.

# Bearer tokens presented on /mcp, one per role profile (doc 01 §6). They nest: a controller
# token also satisfies orchestrator and worker, so mint the narrowest one an agent needs.
WORKSTATE_WORKER_TOKEN=
WORKSTATE_ORCHESTRATOR_TOKEN=
WORKSTATE_CONTROLLER_TOKEN=

# Optional. A read-only token for the JSON read API (doc 10 rule 5): it may call GET /api/v1/* and
# /api/stream and nothing else — no MCP tool, no dashboard sign-in. Foreman authenticates with it.
# Unlike the three above it may stay blank, and blank means no reader token exists.
WORKSTATE_READER_TOKEN=

# The operator's sign-in for the dashboard at / (doc 08 §4). The cookie scheme and the bearer
# tokens above never cross, so this is a second credential and not one of them; leave it unset and
# the auth is fail-closed, which means a login box that cannot succeed.
WORKSTATE_DASHBOARD_USERNAME=
WORKSTATE_DASHBOARD_PASSWORD=

# Optional. The address humans open the dashboard at, e.g. https://workstate.example.lan — the base
# of the `web` link work_brief and work_get print. Blank means the host the agent's request came in
# on (http://127.0.0.1:5290 from this machine), which is right unless a proxy or another name is used.
WORKSTATE_PUBLIC_URL=

# Optional. Comma-separated IPs or CIDRs of the reverse proxy in front of the API, e.g. 172.18.0.0/16
# for a proxy on the same docker network. Only from these addresses are X-Forwarded-Proto/Host/For
# believed, so links and the dashboard cookie follow the https origin the proxy is reached on.
# Blank trusts nobody: the headers are never read, which is right when nothing sits in front.
WORKSTATE_TRUSTED_PROXIES=

# Host port the API is published on.
WORKSTATE_API_PORT=5290

# Host interface the API is published on. Loopback only by default: the dashboard and /mcp are then
# reachable from this machine alone. Set 0.0.0.0 only if you mean to expose it to your network.
WORKSTATE_BIND=127.0.0.1

POSTGRES_DB=workstate
POSTGRES_USER=workstate
POSTGRES_PASSWORD=
